# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=store_ratings
PGUSER=postgres
PGPASSWORD=Postgres@123

# Auth
JWT_SECRET=store-rating@123
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# Initial administrator account, created by "npm run seed"
SEED_ADMIN_NAME=System Administrator Account
SEED_ADMIN_EMAIL=admin@storeratings.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_ADDRESS=Head Office, Platform Administration
